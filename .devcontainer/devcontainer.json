{
  "name": "Animation App",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "remoteEnv": {
    "PATH": "/opt/flutter/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter"
      ]
    }
  },
  "remoteUser": "vscode",
  "postCreateCommand": "sudo .devcontainer/install-flutter.sh"
}
